{
  "name": "mi-recording-cli",
  "version": "0.1.0",
  "description": "A full-featured CLI for Xiaomi Cloud recordings (i.mi.com) — list, search, play, download, incremental pull, delete, and restore or purge from trash. Designed to be AI-friendly.",
  "type": "module",
  "bin": {
    "mi-recording-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --import tsx/esm --test tests/*.test.ts",
    "test:integration": "MI_RECORDING_CLI_INTEGRATION=1 node --import tsx/esm --test tests/integration.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ceynri/mi-recording-cli.git"
  },
  "homepage": "https://github.com/ceynri/mi-recording-cli#readme",
  "bugs": {
    "url": "https://github.com/ceynri/mi-recording-cli/issues"
  },
  "keywords": [
    "xiaomi",
    "mi",
    "recorder",
    "recording",
    "call-recording",
    "cloud",
    "cli",
    "download",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
