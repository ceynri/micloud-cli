{
  "name": "micloud-cli",
  "version": "0.5.0",
  "description": "AI-friendly CLI for Xiaomi Cloud (i.mi.com): notes (read, write, sync to Markdown) and recordings (list, download, incremental pull, cleanup), with one login.",
  "type": "module",
  "bin": {
    "micloud": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --import tsx/esm --test tests/*.test.ts tests/*/*.test.ts",
    "test:integration": "MICLOUD_INTEGRATION=1 node --import tsx/esm --test tests/note/integration.test.ts tests/recording/integration.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ceynri/micloud-cli.git"
  },
  "homepage": "https://github.com/ceynri/micloud-cli#readme",
  "bugs": {
    "url": "https://github.com/ceynri/micloud-cli/issues"
  },
  "keywords": [
    "xiaomi",
    "mi",
    "micloud",
    "note",
    "recorder",
    "recording",
    "cli",
    "markdown",
    "ai"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "commander": "^12.1.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
